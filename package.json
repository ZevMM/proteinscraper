{
  "name": "proteinscraper",
  "version": "0.0.0",
  "private": true,
  "description": "Protein powder price/nutrition comparison site + scraping pipeline",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "db:generate": "pnpm --filter @proteinscraper/db generate",
    "db:migrate": "pnpm --filter @proteinscraper/db migrate",
    "db:push": "pnpm --filter @proteinscraper/db push",
    "db:studio": "pnpm --filter @proteinscraper/db studio",
    "dev": "pnpm --filter @proteinscraper/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
