# --- Database ---------------------------------------------------------------
# Local dev points at the docker-compose Postgres below.
# In prod, set this to your Neon/Supabase pooled connection string.
DATABASE_URL="postgresql://protein:protein@localhost:5432/protein?schema=public"

# --- Scraper ----------------------------------------------------------------
# Anthropic API key for the LLM extraction fallback (Claude Haiku 4.5).
# Leave empty to disable LLM fallback (structured-data-only extraction).
ANTHROPIC_API_KEY=""

# Polite crawling
SCRAPER_USER_AGENT="ProteinScraperBot/0.1 (+https://example.com/about; contact@example.com)"
SCRAPER_REQUESTS_PER_SECOND="1"
SCRAPER_CACHE_DIR=".cache"

# --- Walmart IO Affiliate API (optional) ------------------------------------
# Sanctioned multi-brand retailer source. The walmart source no-ops unless the
# consumer id + private key are set. The private key may be PEM or OpenSSH, on a
# single line with "\n" escapes or as a real multi-line value.
WALMART_CONSUMER_ID=""
WALMART_PRIVATE_KEY=""
WALMART_KEY_VERSION="1"
# Optional affiliate publisher id (Impact) for tracking links.
WALMART_PUBLISHER_ID=""

# --- Amazon via RapidAPI "Real-Time Amazon Data" (optional) -----------------
# The amazon source no-ops unless this is set. Billed per request, so amazon is
# run weekly (separate workflow), not in the daily --all run.
RAPIDAPI_KEY=""

# --- Kroger Products API (optional, free) -----------------------------------
# Register an app at https://developer.kroger.com. The kroger source no-ops
# without these. Authentic per-store prices (config.zip_code picks the store).
KROGER_CLIENT_ID=""
KROGER_CLIENT_SECRET=""

# --- eBay Browse API (optional, free) ---------------------------------------
# Register an app at https://developer.ebay.com (App ID + Cert ID). The ebay
# source is seeded disabled; run it explicitly once keys are set.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# --- Web --------------------------------------------------------------------
# Public base URL of the deployed site (used for canonical links / metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
